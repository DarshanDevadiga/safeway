<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-bg-dark text-text-primary">

    <div class="flex w-full h-screen">

        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <!-- Mobile menu toggle -->
            <button id="menuToggle" class="lg:hidden absolute top-4 right-4 text-text-secondary hover:text-text-primary">
                <i class="fas fa-bars text-xl"></i>
            </button>

            <div class="brand">
                <i class="fas fa-car-crash text-3xl text-status-critical" style="filter: drop-shadow(0 0 10px #f85149);"></i>
                <span class="text-xl font-bold">SAFE WAY</span>
            </div>

            <nav class="nav-menu">
                <a href="/index" class="nav-item">
                    <i class="fas fa-home w-6 text-center"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/live" class="nav-item">
                    <i class="fas fa-chart-line w-6 text-center"></i>
                    <span>Live Sensors</span>
                </a>
                <a href="/location" class="nav-item">
                    <i class="fas fa-map-marked-alt w-6 text-center"></i>
                    <span>GPS Map</span>
                </a>
                <a href="/alert" class="nav-item critical">
                    <i class="fas fa-exclamation-triangle w-6 text-center"></i>
                    <span>Emergency Alerts</span>
                </a>
                <a href="/about" class="nav-item nav-item-spaced">
                    <i class="fas fa-book w-6 text-center"></i>
                    <span>Project Report</span>
                </a>
                <a href="/contact" class="nav-item">
                    <i class="fas fa-envelope w-6 text-center"></i>
                    <span>Contacts / Admin</span>
                </a>
                <a href="/login" class="nav-item nav-item-bottom" onclick="localStorage.removeItem('vadas_active_user');">
                    <i class="fas fa-sign-out-alt w-6 text-center"></i>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">

            <!-- Header -->
            <header class="flex justify-between items-center mb-10">
                <div>
                    <h1 class="text-4xl font-bold text-gradient mb-2">Dashboard Overview</h1>
                    <p class="text-text-secondary page-subtitle">Welcome to the Vehicle Accident Detection Alert System</p>
                </div>
                <div class="user-widget">
                    <span class="user-widget-text"><%= typeof user !== 'undefined' && user ? user.username : 'Admin' %></span>
                    <div class="user-avatar"><%= typeof user !== 'undefined' && user ? user.username.charAt(0).toUpperCase() : 'A' %></div>
                </div>
            </header>

            <!-- System Status Banner -->
            <div class="alert-banner" id="systemBanner">
                <div class="pulsing-dot"></div>
                <div>
                    <strong class="block mb-1">System Live</strong>
                    <span id="system-statusText" class="text-sm text-text-secondary">Active & Monitoring</span>
                </div>
            </div>

            <!-- Quick Stats Grid -->
            <div class="grid-cards">
                <div class="glass-panel stat-card animate-fade-in" style="animation-delay: 0.1s;">
                    <div class="stat-icon icon-blue">
                        <i class="fas fa-car text-2xl"></i>
                    </div>
                    <div class="stat-value"><%= typeof stats !== 'undefined' && stats.activeModules ? stats.activeModules : 1 %></div>
                    <div class="stat-label">Active Modules</div>
                </div>

                <div class="glass-panel stat-card animate-fade-in" style="animation-delay: 0.2s;">
                    <div class="stat-icon icon-green">
                        <i class="fas fa-wifi text-2xl"></i>
                    </div>
                    <div class="stat-value text-status-good"><%= typeof stats !== 'undefined' && stats.networkStatus ? stats.networkStatus : 'Online' %></div>
                    <div class="stat-label">GPS & GSM Network</div>
                </div>

                <div class="glass-panel stat-card animate-fade-in" style="animation-delay: 0.3s;">
                    <div class="stat-icon icon-red">
                        <i class="fas fa-phone-alt text-2xl"></i>
                    </div>
                    <div class="stat-value"><%= typeof stats !== 'undefined' && stats.emergencyContacts ? stats.emergencyContacts : 3 %></div>
                    <div class="stat-label">Emergency Contacts</div>
                </div>

                <div class="glass-panel stat-card animate-fade-in" style="animation-delay: 0.4s;">
                    <div class="stat-icon icon-purple">
                        <i class="fas fa-cloud text-2xl"></i>
                    </div>
                    <div class="stat-value text-2xl mt-2"><%= typeof stats !== 'undefined' && stats.cloudStatus ? stats.cloudStatus : 'Connected' %></div>
                    <div class="stat-label">Cloud Services</div>
                </div>
            </div>

            <!-- System Introduction -->
            <div class="glass-panel animate-fade-in about-container" style="animation-delay: 0.5s;">
                <h2 class="about-title">Project Introduction</h2>
                <p class="section-text">
                    The <strong>Vehicle Accident Detection Alert System</strong> uses advanced IoT hardware including an
                    ESP32 microcontroller, MPU-6500 accelerometer sensor, and a GPS/GSM module. By continuously
                    monitoring the G-force exerted on the vehicle, the system instantly identifies collision patterns.
                </p>
                <p class="section-text">
                    Upon detecting a critical impact, it automatically extracts real-time precise latitude and longitude
                    coordinates and dispatches SMS alerts to pre-configured emergency contacts (Police, Ambulance,
                    Family). Simultaneously, this web dashboard is updated through the cloud, displaying the live map
                    location and sensor diagnostics to expedite rescue operations.
                </p>

                <div class="flex gap-4">
                    <a href="/live" class="btn btn-primary">
                        <i class="fas fa-chart-line"></i>
                        View Live Sensors
                    </a>
                    <a href="/about" class="btn">
                        <i class="fas fa-microchip"></i>
                        Hardware Setup
                    </a>
                </div>
            </div>

            <!-- Recent Activity Preview -->
            <div class="glass-panel animate-fade-in mt-8" style="animation-delay: 0.6s;">
                <h3 class="text-xl font-semibold mb-4">Recent Activity</h3>
                <div id="recent-activity" class="space-y-3">
                    <div class="flex items-center gap-3 p-3 bg-surface/50 rounded-lg">
                        <div class="w-2 h-2 bg-status-good rounded-full"></div>
                        <span class="text-sm text-text-secondary">System initialized successfully</span>
                        <span class="text-xs text-text-secondary ml-auto">Just now</span>
                    </div>
                </div>
            </div>

        </main>

    </div>

    <!-- Modern JavaScript -->
    <script src="/js/app-modern.js"></script>
    
    <!-- Optional: Chart.js for sensor data -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Optional: Leaflet for maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

</body>
</html>
