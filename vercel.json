{
  "rewrites": [
    {
      "source": "/",
      "destination": "/login.html"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/alerts/(.*)",
      "destination": "/api/alerts.js"
    }
  ],
  "functions": {
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/alerts.js": {
      "maxDuration": 10
    }
  }
}